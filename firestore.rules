rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      // A user may create/update their OWN profile but must NOT grant themselves
      // an elevated role: the role must be absent or stay 'buyer' unless an admin
      // is making the change. Admins may set any role.
      allow create: if isAuthenticated() && request.auth.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == 'buyer');
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == uid
          && (!('role' in request.resource.data)
              || request.resource.data.role == resource.data.role
              || request.resource.data.role == 'buyer'))
      );
      allow delete: if isAdmin();
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
  }
}
